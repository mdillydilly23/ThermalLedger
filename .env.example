# Deterministic panel-demo defaults. Copy this file to .env before starting.
DATA_SOURCE=local
GRANITE_MODE=cached

# CORS — space/comma-separated origins. Use * to open all origins for a public demo URL.
# Example: ALLOWED_ORIGINS=https://your-demo-host.example.com
ALLOWED_ORIGINS=http://localhost:5173

# Native-service defaults. Docker Compose overrides ML_SERVICE_URL for backend
# and worker containers.
ML_SERVICE_URL=http://localhost:8001
DATA_DIR=../data
UPLOADS_DIR=../data/uploads/esg
AUDIT_DIR=../data/audit
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Optional live-data credentials. They are not needed for the deterministic demo.
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
COPERNICUS_CLIENT_ID=cdse-public
CDS_API_KEY=

# Demo API key — guard mutating endpoints (upload, verification runs, report generation).
# Set to a non-empty value when deploying to a public URL.
# Leave empty for local development (guard is a no-op when blank).
DEMO_API_KEY=thermalledger-demo

# Optional IBM credentials. Leave blank for GRANITE_MODE=cached.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Model used in GRANITE_MODE=live. ibm/granite-3-8b-instruct is the current default.
GRANITE_MODEL_ID=ibm/granite-3-8b-instruct

# IBM Environmental Intelligence Suite (EIS) — E-3: satellite data enrichment.
# Set EIS_API_KEY to enable the /eis/methane endpoint and the EIS live badge
# in the Prototype readiness panel.
EIS_API_KEY=
EIS_BASE_URL=https://api.ibm.com/geospatial/run/na/core/v3

# IBM watsonx.data (Presto) — E-4: federated facility registry queries.
# Set WATSONXDATA_HOST and WATSONXDATA_ACCESS_TOKEN to enable the watsonx.data
# query path for facility registry lookups.
WATSONXDATA_HOST=
WATSONXDATA_PORT=443
WATSONXDATA_ACCESS_TOKEN=
