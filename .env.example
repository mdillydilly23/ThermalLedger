# Deterministic panel-demo defaults. Copy this file to .env before starting.
DATA_SOURCE=local
GRANITE_MODE=cached

# Native-service defaults. Docker Compose overrides ML_SERVICE_URL for backend
# and worker containers.
ML_SERVICE_URL=http://localhost:8001
DATA_DIR=../data
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Optional live-data credentials. They are not needed for the deterministic demo.
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
COPERNICUS_CLIENT_ID=cdse-public
CDS_API_KEY=

# Optional IBM credentials. Leave blank for GRANITE_MODE=cached.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
